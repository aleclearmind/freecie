--- /dev/null
+++ b/CieSDK/src/main/java/it/pagopa/io/app/cie/cie/key_store/CieSigner.kt
@@ -0,0 +1,17 @@
+package it.pagopa.io.app.cie.cie.key_store
+
+import it.pagopa.io.app.cie.cie.NfcEvent
+import it.pagopa.io.app.cie.cie.commands.CieCommands
+
+/**
+ * The card session the JCA provider signs with, set by the app only while a
+ * card is connected. Replaces `ReadCie.cieCommands` so the provider can be used
+ * without the SDK's own NFC session classes.
+ */
+internal object CieSigner {
+    @Volatile
+    var commands: CieCommands? = null
+
+    fun sign(data: ByteArray, event: NfcEvent): ByteArray =
+        checkNotNull(commands?.sign(data, event)) { "No CIE connected for signing" }
+}
